+export type MatroskaInputFormatOptions = {
+	/** Called with each block of a track the input doesn't read, as its cluster is parsed, again if it's parsed again. */
+	onOtherTrackBlock?: (block: MatroskaOtherTrackBlock) => void;
 };
 
