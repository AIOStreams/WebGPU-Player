+/**
+ * Returns the HEVC codec string for a single-layer Dolby Vision profile 5 or 8 configuration record.
+ * The dvhe sample entry allows parameter sets in the samples as well as in hvcC.
+ * @group Codecs
+ * @public
+ */
+export const getDolbyVisionHevcCodec = (record: Uint8Array) => {
+	if (record.length < 24 || record.length > 1024 || record[0] !== 1) return null;
+	const profile = record[2]! >> 1;
+	const level = ((record[2]! & 1) << 5) | (record[3]! >> 3);
+	// A single video track carries the base layer and RPU. A separate enhancement layer would be lost.
+	if ((profile !== 5 && profile !== 8) || !level || (record[3]! & 7) !== 5) return null;
+	return `dvhe.${String(profile).padStart(2, '0')}.${String(level).padStart(2, '0')}`;
+};
